# Topstep credentials - copy to .env and fill in your values
TOPSTEP_USERNAME=your_email@example.com
TOPSTEP_API_KEY=your_api_key_here

# Trading cutoff in MST (Phoenix, UTC-7).  Broker defaults:
#   TopstepX = 13:10  (exchange closes 15:10 CT)
#   Lucid     = 13:45
#   Tradeify  = 13:59
# TRADING_CUTOFF_MST=13:10
